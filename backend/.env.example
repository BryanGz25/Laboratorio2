# Puerto del servidor
PORT=3000

# Ruta del archivo SQLite (relativa a la carpeta backend/)
DB_PATH=tienda.db

# Orígenes permitidos para CORS, separados por coma. Vacío = permitir todos (solo desarrollo)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Reglas de envío
CIUDAD_LOCAL=San José
ENVIO_LOCAL=5
ENVIO_OTRAS_CIUDADES=15
ENVIO_GRATIS_DESDE=100
